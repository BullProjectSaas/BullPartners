rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function path(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    // Dueño: acceso total por email, aunque su perfil no exista o cambie su ID.
    function owner() { return signed() && request.auth.token.email in ['leonellallanapersonal@gmail.com']; }
    function myEmail() { return request.auth.token.email.lower(); }
    function hasProfile() { return signed() && request.auth.token.email != null && exists(path('users', myEmail())); }
    function me() { return get(path('users', myEmail())).data; }
    function staff() { return owner() || (hasProfile() && me().role in ['admin', 'team']); }
    function admin() { return owner() || (hasProfile() && me().role == 'admin'); }
    function clientOf(cid) { return !owner() && hasProfile() && me().role == 'client' && me().clientId == cid; }
    function mine() { return clientOf(resource.data.clientId); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Perfiles: el ID del documento es el email (en minúsculas).
    match /users/{email} {
      allow read: if staff() || (signed() && myEmail() == email) || (hasProfile() && resource.data.role in ['admin', 'team']);
      allow create: if admin() || (owner() && myEmail() == email && request.resource.data.role == 'admin');
      allow update, delete: if admin();
    }
    match /clients/{cid} {
      allow read: if staff() || clientOf(cid);
      allow write: if admin();
    }
    match /projects/{id} {
      allow read: if staff() || mine();
      allow write: if staff();
    }
    match /news/{id} {
      allow read: if staff() || mine();
      allow write: if staff();
    }
    match /tasks/{id} {
      allow read: if staff() || (mine() && resource.data.visibleToClient == true);
      allow create, delete: if staff();
      allow update: if staff() || (mine() && resource.data.visibleToClient == true && onlyChanges(['status']));
    }
    match /deliverables/{id} {
      allow read: if staff() || (mine() && resource.data.status in ['aprobacion', 'cambios', 'aprobado']);
      allow create, delete: if staff();
      allow update: if staff() || (mine() && resource.data.status == 'aprobacion' && onlyChanges(['status', 'history']));
    }
    match /reports/{id} {
      allow read: if staff() || (mine() && resource.data.published == true);
      allow create, delete: if staff();
      allow update: if staff() || (mine() && resource.data.published == true && onlyChanges(['readAt']));
    }
    match /files/{id} {
      allow read: if staff() || (mine() && resource.data.shared == true);
      allow create: if staff() || (clientOf(request.resource.data.clientId) && request.resource.data.shared == true);
      allow update, delete: if staff();
    }
    match /comments/{id} {
      allow read: if staff() || (mine() && resource.data.internal == false);
      allow create: if staff() || (clientOf(request.resource.data.clientId) && request.resource.data.internal == false && request.resource.data.by == myEmail());
      allow update, delete: if staff();
    }
    match /notifications/{id} {
      allow read: if signed() && resource.data.userId == myEmail();
      allow create: if staff() || hasProfile();
      allow update: if signed() && resource.data.userId == myEmail() && onlyChanges(['read']);
      allow delete: if admin();
    }
  }
}
